{% extends 'base.html.twig' %}

{% block title %}Bibliothèque de citations{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 mb-1 fw-bold">Bibliothèque de citations OAT ✅</h1>
            <p class="text-muted small mb-0">{{ quotes|length }} citation(s) répertoriée(s)</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_quote_leaderboard') }}" class="btn btn-outline-warning text-dark fw-semibold">
                🏆 Voir le classement d'Aura
            </a>
            <a href="{{ path('app_quote_new') }}" class="btn btn-primary fw-semibold">
                + Ajouter une citation
            </a>
        </div>
    </div>

    {% if quotes is empty %}
        <div class="alert alert-light text-center py-5 border rounded-3 my-4">
            <p class="fs-5 text-muted mb-3">Désolé, aucune citation n'est disponible pour le moment.</p>
            <a href="{{ path('app_quote_new') }}" class="btn btn-sm btn-primary">Créer la première citation</a>
        </div>
    {% else %}
        <div class="quote-grid">
            {% for quote in quotes %}
                <article class="quote-card">
                    <div>
                        <a href="{{ path('app_quote_show', { id: quote.id }) }}" class="quote-text">
                            « {{ quote.content }} »
                        </a>
                        <span class="quote-author">— {{ quote.author }}</span>
                    </div>

                    <div class="quote-footer">
                        {% if quote.aura is not null %}
                            <span class="badge-aura">✨ {{ quote.aura }} Aura</span>
                        {% else %}
                            <span></span>
                        {% endif %}

                        <div class="btn-group btn-group-sm">
                            <a href="{{ path('app_quote_show', { id: quote.id }) }}" class="btn btn-outline-secondary">Voir</a>
                            <a href="{{ path('app_quote_edit', { id: quote.id }) }}" class="btn btn-outline-primary">Modifier</a>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
