{% extends 'base.html.twig' %}

{% block title %}Hello QuoteController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Bienvenue sur la meilleure bibliothèque de citations FOA ✅</h1>
    {% for quote in quotes %}
        <p>
            <a href="{{ path('app_quote_show', { id: quote.id }) }}">
                "{{ quote.content }}"
            </a>
            — <strong>{{ quote.author }}</strong>
        </p>
        {% else %}

        <p>
            Désolé aucune citation n'est disponible pour le moment.
        </p>

    {% endfor %}

    <p>
        <a href="{{ path('app_quote_new') }}">+ Ajouter une citation</a>
    </p>

</div>
{% endblock %}
